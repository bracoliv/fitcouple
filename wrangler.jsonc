{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fitcouple-game",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  // Logs and traces help Brian see errors. Query strings are stripped.
  // Request bodies are never logged by the Worker code. See PRIVACY.md.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:8788,http://localhost:8788,http://127.0.0.1:8790,http://localhost:8790,https://bracoliv.github.io",
    "VOUCHERS_ENABLED": "false",
    "VOUCHER_EXPIRY_DAYS": "30",
    "VOUCHER_VERIFIED_DAYS": "1",
    "VOUCHER_VALUE_LABEL": "value",
    "VOUCHER_PREFIX": "FIT",
    "VOUCHER_MILESTONES": "",
    "STORE_ENABLED": "false",
    "STORE_MODE": "external",
    "STORE_GATEWAY": "",
    "STORE_SANDBOX": "true",
    "STORE_CURRENCY": "RM",
    "STORE_PUMP_CATALOG": "",
    "STORE_SLIM_CATALOG": "",
    "STORE_SELLER_NAME": "",
    "STORE_SELLER_LINE": "",
    "STORE_SELLER_CONTACT": "",
    "AI_MODEL": "gemini-3.5-flash-lite",
    "AI_PROVIDER_ORDER": "google,qwen,openai",
    "AI_GOOGLE_MODEL": "gemini-3.5-flash-lite",
    "AI_GOOGLE_BASE_URL": "https://generativelanguage.googleapis.com/v1beta",
    "AI_QWEN_MODEL": "qwen3-vl-plus",
    "AI_QWEN_BASE_URL": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
    "AI_OPENAI_MODEL": "gpt-6-luna",
    "AI_OPENAI_BASE_URL": "https://api.openai.com/v1",
    "AI_PRICE_TABLE": "",
    "AI_USD_TO_RM": "4.084",
    "AI_LIMIT_FOOD_PHOTO": "10",
    "AI_LIMIT_TEXT_LOG": "20",
    "AI_LIMIT_RECOMMEND": "5",
    "AI_LIMIT_CHAT": "20",
    "PREMIUM_PAYMENTS_ENABLED": "false"
  },
  // ADMIN_KEY, GEMINI_API_KEY, QWEN_API_KEY, and OPENAI_API_KEY are secrets.
  // Local: .dev.vars. Live: `npx wrangler secret put GEMINI_API_KEY` (and the other two if you use them).
  "secrets": {
    "required": ["ADMIN_KEY"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitcouple-game",
      // Replace this after `npx wrangler d1 create fitcouple-game`.
      // Any id works for local `wrangler dev`. Deploy needs the real one.
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ]
}
