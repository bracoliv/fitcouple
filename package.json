{
  "name": "fitcouple",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --experimental-strip-types --test test/brain.test.ts test/summary.test.mjs test/worker.test.ts test/build.test.mjs",
    "worker": "wrangler dev --port 8787 --ip 127.0.0.1 --local --show-interactive-dev-session false",
    "types": "wrangler types",
    "db:apply": "wrangler d1 migrations apply fitcouple-game --local",
    "deploy:worker": "wrangler deploy"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "javascript-obfuscator": "^5.10.1",
    "wrangler": "^4.161.0"
  }
}
