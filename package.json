{
  "name": "fitcouple",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "build": "node --experimental-strip-types scripts/build.ts",
    "preview": "node --experimental-strip-types scripts/preview.ts",
    "theme": "esbuild test/theme.ts --outfile=test/theme.js --bundle --format=iife --target=es2022",
    "test": "npm run typecheck && npm run theme && node --experimental-strip-types test/theme.ts && node --experimental-strip-types --test test/brain.test.ts test/summary.test.ts test/avatar.test.ts test/assist.test.ts test/guard.test.ts test/auth.test.ts test/worker.test.ts test/build.test.ts",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.scripts.json",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "worker": "wrangler dev --port 8787 --ip 127.0.0.1 --local --show-interactive-dev-session false",
    "types": "wrangler types",
    "db:apply": "wrangler d1 migrations apply fitcouple-game --local",
    "deploy:worker": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "javascript-obfuscator": "^5.10.1",
    "playwright": "^1.65.1",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "wrangler": "^4.161.0"
  },
  "dependencies": {
    "uqr": "^0.1.3"
  }
}
